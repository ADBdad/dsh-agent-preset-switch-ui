{
  "name": "@dsh-external/dsh-agent-preset-switch-ui",
  "version": "1.0.0",
  "description": "Clickable agent-preset switcher in the session header, with its own switch engine. Mid-session switching takes effect from this moment on; no dependency on other plugins.",
  "type": "module",
  "main": "./lib/index.js",
  "icon": "./icon.svg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ADBdad/dsh-agent-preset-switch-ui.git"
  },
  "homepage": "https://github.com/ADBdad/dsh-agent-preset-switch-ui#readme",
  "bugs": {
    "url": "https://github.com/ADBdad/dsh-agent-preset-switch-ui/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent-preset",
    "switch",
    "ui",
    "cordis"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/config.mjs && node test/client.mjs"
  },
  "dsh": {
    "compatibility": {
      "dsh": "0.2.x",
      "node": ">=18"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*"
  }
}
